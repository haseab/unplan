# Create an OAuth 2.0 Web application in Google Cloud, enable the Google
# Calendar API, and register every environment as an authorized JavaScript
# origin. The browser uses this public client ID; the server exchanges codes
# with the matching secret. Use different Google projects for dev/production.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public application origin for OAuth and same-origin request validation.
# Set https://unplan.io on Railway; keep localhost for local development.
APP_ORIGIN=http://localhost:3004

# PostgreSQL stores encrypted Google credentials and hashed app-session IDs.
DATABASE_URL=
# A stable, base64-encoded 32-byte random key; never expose it to the browser.
# Keep it separately from the database and preserve it across deployments.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Server-side task refresh (same Todoist account as the browser).
TODOIST_API_KEY=
# Shared with the Cloudflare Worker; generate a random secret.
TASK_REFRESH_SECRET=

# Enable only after the Cloudflare schedule is installed and verified.
TASK_REFRESH_ENABLED=false

# Native BB frontend. Separate full-access key; never reuse ATTENTION_API_KEY.
BB_API_KEY=
BB_GOOGLE_OWNER_ID=
