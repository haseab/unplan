# Create an OAuth 2.0 Web application in Google Cloud, enable the Google
# Calendar API, and register every environment's exact redirect URI:
#   http://localhost:3000/api/google/callback
#   https://unplan.io/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use the URI for the environment being configured. When omitted, Unplan
# derives it from proxy-aware request headers.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
